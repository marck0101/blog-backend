{
  "name": "node-express-mongodb",
  "version": "1.0.0",
  "description": "Node.js Restful CRUD API with Node.js, Express and MongoDB",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "cross-env PORT=3333 NODE_ENV=development nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "prod": "cross-env PORT=3333 NODE_ENV=production nodemon server.js",
    "backfill:covers": "node scripts/backfill-cover-variants.js",
    "backfill:image-sizes": "cross-env NODE_ENV=production node scripts/backfill-content-image-sizes.js",
    "test:watch": "vitest"
  },
  "keywords": [
    "nodejs",
    "express",
    "rest",
    "api",
    "mongodb"
  ],
  "author": "Marcos",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.6.3",
    "multer": "^2.1.1",
    "nodemailer": "^10.2.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "turndown": "7.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^10.4.3",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  }
}
