    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.6.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.10"
  }
