# Ambiente: development | production
NODE_ENV=development

# Porta do servidor
PORT=3333

# MongoDB
# Dev: instância local
MONGO_URI_DEV=mongodb://127.0.0.1:27017/blog_project
# Prod: MongoDB Atlas — substitua USER, PASS e CLUSTER
MONGO_URI_PROD=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/blog_project?retryWrites=true&w=majority&authSource=admin

# JWT — gere um segredo forte (mínimo 64 caracteres hex)
# Exemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_FORTE_COM_MINIMO_64_CARACTERES

# Criptografia do app autenticador (2FA) guardado no banco. Gere como o JWT_SECRET.
# Sem ela, usa uma chave derivada do JWT_SECRET (trocar o JWT_SECRET invalidaria o 2FA).
MFA_SECRET_KEY=

# Assinatura dos links rastreados dos emails (opcional; sem ela usa o JWT_SECRET)
TRACKING_SECRET=

# Origens do painel para os redirecionamentos de login (opcional)
# CORS_DEV=http://localhost:5173
# CORS_PROD=https://blog.marck0101.com.br

# Login com Google (painel e comentários de leitores)
# Console: console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
# Opcional: padrão = mesma URL com /api/comments/google/callback
# GOOGLE_READER_REDIRECT_URI=

# Rotina diária (agendados, retomada de envios, alertas). Na Vercel, a mesma
# variável no projeto faz o cron mandar "Authorization: Bearer <valor>".
CRON_SECRET=

# LinkedIn (produto "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3333/api/linkedin/callback
# Opcional: versão da API (YYYYMM; cada versão vale ~1 ano)
# LINKEDIN_API_VERSION=202609

# Firebase Storage (bucket name — sem gs://)
FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
# Produção (Vercel/serverless): cole o JSON inteiro da service account como string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Dev: coloque o arquivo service-account.json na raiz do projeto (já está no .gitignore)
# Como obter: Firebase Console → Configurações → Contas de serviço → Gerar nova chave

# Admin inicial criado automaticamente no primeiro boot (desenvolvimento).
# ADMIN_EMAIL também recebe os alertas diários e os avisos de comentário novo.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@seudominio.com
# Atenção: use aspas se a senha contiver # ou outros caracteres especiais
ADMIN_PASSWORD="SUA_SENHA_FORTE_AQUI"

# Email (Nodemailer + Gmail SMTP)
# Como gerar: myaccount.google.com/security → Verificação em duas etapas → Senhas de app
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=senha_de_app_16_chars

# Só desenvolvimento local: login sem o 2º fator (ignorado fora de NODE_ENV=development e na Vercel)
SKIP_2FA=false
